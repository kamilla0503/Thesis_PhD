 		isbn = {1572-9613},
 		journal = {Journal of Statistical Physics},
 		number = {3},
 		pages = {483--531},
 		title = {New Monte Carlo method for the self-avoiding walk},
 		url = {https://doi.org/10.1007/BF01017183},
